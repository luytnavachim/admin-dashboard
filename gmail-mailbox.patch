+// ============================================================
+//  GMAIL (Google Identity Services + Gmail REST API)
+//  De Gmail-mailbox gedraagt zich als een Graph-mailbox: userPath() geeft
+//  "/gmail" en graph()/graphBinary() sturen die paden naar gmailShim(), die
+//  de handvol gebruikte Graph-endpoints vertaalt naar Gmail-calls. Zo werken
+//  scan, → Moneybird, Verwerkt (label "MoneyMonk Verwerkt/<afzender>"),
+//  doorsturen en de Moneybird-controle ongewijzigd voor Gmail.
+//  Token: alleen in sessionStorage (1 uur); stil vernieuwd zolang de
+//  Google-sessie leeft, anders knop "Gmail koppelen" in de topbar.
+// ============================================================
+const GMAIL_API = "https://gmail.googleapis.com/gmail/v1/users/me";
+const GMAIL_SCOPE = "https://www.googleapis.com/auth/gmail.modify";   // lezen + labels + versturen (geen permanent verwijderen)
+const GMAIL_TOKEN_KEY = "gmail_token_v1";
+const GMAIL_WELLKNOWN = { inbox: "INBOX", sentitems: "SENT", deleteditems: "TRASH", drafts: "DRAFT", junkemail: "SPAM" };
+let _gmailTokenClient = null;
+let _gmailTok = null;          // { access_token, exp }
+let _gmailLabels = null;
+let _gmailHinted = false;
+
+function gmailMbox() { return MAILBOXES.find(m => m.provider === "gmail"); }
+function gmailEnabled() { return !!(GMAIL_CLIENT_ID && gmailMbox()); }
+function gmailLoadStoredToken() {
+  try { const t = JSON.parse(sessionStorage.getItem(GMAIL_TOKEN_KEY)); if (t && t.access_token && t.exp > Date.now() + 60000) _gmailTok = t; } catch (e) {}
+}
+function gmailIsConnected() { if (!_gmailTok) gmailLoadStoredToken(); return !!(_gmailTok && _gmailTok.exp > Date.now() + 60000); }
+function gmailInit() {
+  if (!gmailEnabled() || _gmailTokenClient) return;
+  if (!(window.google && google.accounts && google.accounts.oauth2)) return;   // GIS nog niet geladen → onload roept opnieuw
+  _gmailTokenClient = google.accounts.oauth2.initTokenClient({
+    client_id: GMAIL_CLIENT_ID, scope: GMAIL_SCOPE, hint: gmailMbox().email,
+    callback: (resp) => {
+      const pend = _gmailPending; _gmailPending = null;
+      if (resp && resp.access_token) {
+        _gmailTok = { access_token: resp.access_token, exp: Date.now() + (Number(resp.expires_in) || 3600) * 1000 };
+        try { sessionStorage.setItem(GMAIL_TOKEN_KEY, JSON.stringify(_gmailTok)); } catch (e) {}
+        gmailUpdateUi();
+        if (pend) pend.resolve(_gmailTok.access_token);
+      } else if (pend) pend.reject(new Error((resp && (resp.error_description || resp.error)) || "Gmail-token geweigerd"));
+    },
+    error_callback: (err) => { const pend = _gmailPending; _gmailPending = null; if (pend) pend.reject(new Error((err && (err.message || err.type)) || "Gmail-popup mislukt")); }
+  });
+  gmailLoadStoredToken();
+  gmailUpdateUi();
+}
+let _gmailPending = null;
+function gmailRequestToken(interactive) {
+  return new Promise((resolve, reject) => {
+    if (!_gmailTokenClient) return reject(new Error("Gmail niet geconfigureerd (GMAIL_CLIENT_ID leeg of Google-script niet geladen)"));
+    if (_gmailPending) return reject(new Error("Gmail-login loopt al"));
+    _gmailPending = { resolve, reject };
+    // prompt "" = geen scherm als de Google-sessie + toestemming er al zijn (eerste keer toont Google zelf de consent);
+    // "none" = nooit een scherm (stil vernieuwen; mislukt zonder klik als de browser de popup blokkeert).
+    try { _gmailTokenClient.requestAccessToken({ prompt: interactive ? "" : "none" }); }
+    catch (e) { _gmailPending = null; reject(e); }
+  });
+}
+async function gmailToken() {
+  if (gmailIsConnected()) return _gmailTok.access_token;
+  try { return await gmailRequestToken(false); }   // stil vernieuwen
+  catch (e) {
+    gmailUpdateUi();
+    const err = new Error("Gmail niet gekoppeld — klik op 'Gmail koppelen' bovenin"); err.gmailNotConnected = true; throw err;
+  }
+}
+// Voor de Overzicht-scan: zonder token Gmail overslaan en één keer een hint tonen.
+function gmailReadyForScan() {
+  if (!gmailEnabled()) return false;
+  if (gmailIsConnected()) return true;
+  if (!_gmailHinted) {
+    _gmailHinted = true;
+    const el = document.createElement("div"); el.className = "err";
+    el.innerHTML = 'ℹ Gmail staat nog niet aan voor deze sessie. <button class="btn" onclick="gmailConnect()">Gmail koppelen</button>';
+    $("alert-area").appendChild(el);
+  }
+  return false;
+}
+async function gmailConnect() {
+  try {
+    await gmailRequestToken(true);
+    devLog("gmail: gekoppeld", "ok");
+    showToast("Gmail gekoppeld", "ok");
+    $("alert-area").innerHTML = ""; _gmailHinted = false;
+    loadAll();
+  } catch (e) { showToast("Gmail koppelen mislukt: " + (e.message || e), "err"); }
+}
+function gmailUpdateUi() {
+  const b = $("gmail-connect-btn"); if (!b) return;
+  if (!gmailEnabled()) { b.style.display = "none"; return; }
+  b.style.display = "";
+  const on = gmailIsConnected();
+  b.textContent = on ? "Gmail ✓" : "Gmail koppelen";
+  b.title = on ? "Gmail gekoppeld — klik om het token te vernieuwen" : "Koppel " + gmailMbox().email + " zodat facturen uit Gmail in het overzicht komen";
+  b.onclick = gmailConnect;
+}
+
+async function gmailFetch(method, path, body, retries) {
+  const token = await gmailToken();
+  const url = path.startsWith("http") ? path : GMAIL_API + path;
+  const t0 = performance.now();
+  devLog(`gmail ${method} ${path.replace(/\?.*$/, "").slice(0, 70)}`, "dim");
+  const opts = { method, headers: { Authorization: "Bearer " + token } };
+  if (body !== undefined) { opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(body); }
+  const res = await fetch(url, opts);
+  const ms = Math.round(performance.now() - t0);
+  if (!res.ok) {
+    if (res.status === 401) { _gmailTok = null; try { sessionStorage.removeItem(GMAIL_TOKEN_KEY); } catch (e) {} gmailUpdateUi(); }
+    const txt = await res.text();
+    let msg; try { msg = JSON.parse(txt).error.message; } catch (e) { msg = txt.slice(0, 120) || ("HTTP " + res.status); }
+    const left = (retries == null ? 3 : retries);
+    if ((res.status === 429 || res.status >= 500) && left > 0) {
+      const waitMs = 1500 * (4 - left);
+      devLog(`  throttled · retry in ${waitMs}ms`, "warn");
+      await new Promise(r => setTimeout(r, waitMs));
+      return gmailFetch(method, path, body, left - 1);
+    }
+    devLog(`  ✗ ${res.status} ${ms}ms · ${msg.slice(0, 80)}`, "err");
+    throw new Error("Gmail " + res.status + ": " + msg);
+  }
+  devLog(`  ✓ ${res.status} ${ms}ms`, "ok");
+  if (res.status === 204) return null;
+  return await res.json();
+}
+async function gmailMapLimit(items, limit, fn) {
+  const out = new Array(items.length); let i = 0;
+  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (i < items.length) { const k = i++; out[k] = await fn(items[k], k); }
+  }));
+  return out;
+}
+function gmailB64urlToBytes(s) {
+  s = String(s || "").replace(/-/g, "+").replace(/_/g, "/");
+  while (s.length % 4) s += "=";
+  const bin = atob(s); const u = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);
+  return u;
+}
+function gmailBytesToB64url(bytes) { return arrayBufferToBase64(bytes.buffer || bytes).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, ""); }
+
+// ---- labels (= mappen) ----
+async function gmailLabels(force) {
+  if (_gmailLabels && !force) return _gmailLabels;
+  const r = await gmailFetch("GET", "/labels");
+  _gmailLabels = (r.labels || []);
+  return _gmailLabels;
+}
+function gmailLabelLeaf(name) { const i = name.lastIndexOf("/"); return i < 0 ? name : name.slice(i + 1); }
+async function gmailCreateLabel(name) {
+  const existing = (await gmailLabels(true)).find(l => l.name === name);
+  if (existing) return { id: existing.id, displayName: gmailLabelLeaf(existing.name) };
+  const lab = await gmailFetch("POST", "/labels", { name, labelListVisibility: "labelShow", messageListVisibility: "show" });
+  _gmailLabels = null;
+  return { id: lab.id, displayName: gmailLabelLeaf(lab.name) };
+}
+
+// ---- berichten → Graph-vorm ----
+function gmailHeader(hs, name) { const h = (hs || []).find(x => (x.name || "").toLowerCase() === name.toLowerCase()); return h ? h.value : ""; }
+function gmailParseAddr(s) {
+  const m = /^\s*"?([^"<]*?)"?\s*<([^>]+)>\s*$/.exec(s || "");
+  if (m) return { emailAddress: { name: m[1].trim(), address: m[2].trim().toLowerCase() } };
+  return { emailAddress: { name: "", address: (s || "").trim().toLowerCase() } };
+}
+function gmailParseAddrList(s) { return (s || "").split(/,(?![^<]*>)/).map(x => x.trim()).filter(Boolean).map(gmailParseAddr); }
+function gmailWalkParts(p, out) { if (!p) return out; if (p.parts && p.parts.length) p.parts.forEach(x => gmailWalkParts(x, out)); else out.push(p); return out; }
+function gmailAttachmentsOf(payload) {
+  return gmailWalkParts(payload, []).filter(p => p.filename && p.body && p.body.attachmentId).map(p => ({
+    id: p.body.attachmentId, name: p.filename, contentType: p.mimeType || "", size: (p.body && p.body.size) || 0,
+    isInline: /inline/i.test(gmailHeader(p.headers, "Content-Disposition")) && !!gmailHeader(p.headers, "Content-ID")
+  }));
+}
+function gmailToGraphMessage(m) {
+  const hs = (m.payload && m.payload.headers) || [];
+  const labels = m.labelIds || [];
+  const atts = gmailAttachmentsOf(m.payload);
+  const info = _folderInfoCache[(gmailMbox() || {}).email];
+  // "Map": een overslaan-label (Verzonden/Prullenbak/Verwerkt…) wint, dan Inbox, dan het eerste eigen label, anders "ARCHIVE".
+  const folder = (info && labels.find(l => info.skip.has(l)))
+    || (labels.includes("INBOX") ? "INBOX" : (labels.find(l => /^Label_/.test(l)) || "ARCHIVE"));
+  return {
+    id: m.id, internetMessageId: gmailHeader(hs, "Message-ID") || m.id, subject: gmailHeader(hs, "Subject"),
+    from: gmailParseAddr(gmailHeader(hs, "From")), toRecipients: gmailParseAddrList(gmailHeader(hs, "To")),
+    receivedDateTime: new Date(Number(m.internalDate) || Date.now()).toISOString(),
+    hasAttachments: atts.some(a => !a.isInline), isRead: !labels.includes("UNREAD"), bodyPreview: m.snippet || "",
+    webLink: `https://mail.google.com/mail/u/0/#all/${m.id}`, parentFolderId: folder, _labelIds: labels, attachments: atts
+  };
+}
+const GMAIL_META_FIELDS = "id,labelIds,snippet,internalDate,payload(mimeType,filename,headers,body(size,attachmentId),parts(partId,mimeType,filename,headers,body(size,attachmentId),parts(partId,mimeType,filename,headers,body(size,attachmentId),parts(partId,mimeType,filename,headers,body(size,attachmentId)))))";
+async function gmailGetMeta(id) { return gmailFetch("GET", `/messages/${encodeURIComponent(id)}?format=full&fields=${encodeURIComponent(GMAIL_META_FIELDS)}`); }
+
+// Graph-$filter → Gmail-zoekopdracht (alleen wat het dashboard gebruikt).
+function gmailQueryFromFilter(filter) {
+  const q = ["-in:sent", "-in:trash", "-in:drafts", "-in:spam", "-in:chats"];
+  let m;
